{
  "name": "workout-planner",
  "version": "1.0.0",
  "description": "A simple rule-based TypeScript CLI that generates a weekly gym workout plan built around your favorite lifts, scheduled around planned runs, informed by previous workouts, and adapted to your current goal phase (cut then bulk).",
  "type": "module",
  "scripts": {
    "plan": "tsx src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.2",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
